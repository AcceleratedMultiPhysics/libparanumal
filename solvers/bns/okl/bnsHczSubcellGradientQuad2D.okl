// HCZ subcell derivatives matching derivative(value,axis,true,oneSided).
// potentials: [element][psiPhi,psiRho][y subcell][x subcell].
// gradients: [element][psiPhi_x,psiPhi_y,psiRho_x,psiRho_y][subcell].
// neighbors[e][(dy+1)*3+dx+1] includes self and prepared potential halos.
// x is periodic; only y-wall entries may be negative. hx/hy are positive
// Cartesian element widths. All input values must be finite.
#if p_Nfields != 12
#error HCZ subcell gradients require twelve solution fields
#endif
#if p_Nq < 2
#error HCZ subcell gradients require polynomial degree at least one
#endif
#define p_Nsubq (2*p_Nq-1)
#define p_Nsubp (p_Nsubq*p_Nsubq)

@kernel void bnsHczSubcellGradientQuad2D(const dlong Nelements,
                                        @restrict const dlong *elementIds,
                                        @restrict const dlong *neighbors,
                                        const dfloat hx,
                                        const dfloat hy,
                                        @restrict const dfloat *potentials,
                                        @restrict dfloat *gradients){
  for(dlong et=0;et<Nelements;++et;@outer(0)){
    for(int lane=0;lane<128;++lane;@inner(0)){
      for(int node=lane;node<p_Nsubp;node+=128){
        const dlong e=elementIds[et];
        const int i=node%p_Nsubq,j=node/p_Nsubq;
        dlong exM=e,exP=e,eyM=e,eyP=e;
        int im=i-1,ip=i+1,jm=j-1,jp=j+1;
        if(im<0){exM=neighbors[9*e+3];im+=p_Nsubq;}
        if(ip>=p_Nsubq){exP=neighbors[9*e+5];ip-=p_Nsubq;}
        if(jm<0){
          eyM=neighbors[9*e+1];
          if(eyM<0){eyM=e;jm=0;}
          else jm+=p_Nsubq;
        }
        if(jp>=p_Nsubq){
          eyP=neighbors[9*e+7];
          if(eyP<0){eyP=e;jp=p_Nsubq-1;}
          else jp-=p_Nsubq;
        }
        for(int p=0;p<2;++p){
          const dlong base=(e*2+p)*p_Nsubp+node;
          const dfloat gx=(potentials[(exP*2+p)*p_Nsubp+j*p_Nsubq+ip]
                         -potentials[(exM*2+p)*p_Nsubp+j*p_Nsubq+im])/(2*hx/p_Nsubq);
          dfloat gy=(potentials[(eyP*2+p)*p_Nsubp+jp*p_Nsubq+i]
                    -potentials[(eyM*2+p)*p_Nsubp+jm*p_Nsubq+i])/(2*hy/p_Nsubq);
          // Only the hydrodynamic pressure correction uses one-sided wall
          // derivatives. The index potential retains copied scalar ghosts.
          if(p==1 && j==0 && neighbors[9*e+1]<0)
            gy=(-3*potentials[base]+4*potentials[base+p_Nsubq]
                -potentials[base+2*p_Nsubq])/(2*hy/p_Nsubq);
          if(p==1 && j==p_Nsubq-1 && neighbors[9*e+7]<0)
            gy=(3*potentials[base]-4*potentials[base-p_Nsubq]
                +potentials[base-2*p_Nsubq])/(2*hy/p_Nsubq);
          gradients[(e*4+2*p)*p_Nsubp+node]=gx;
          gradients[(e*4+2*p+1)*p_Nsubp+node]=gy;
        }
      }
    }
  }
}
