// Cartesian DG-to-subcell preparation matching QuadOperator::hybrid.
// q: [element][12 moments][DG node]. sub: [element][12 moments][subcell].
// A: [DG node][subcell coordinate], i.e. A[s+i*p_Nsubq].
#if p_Nfields != 12
#error HCZ subcell preparation requires twelve fields
#endif
#define p_Nsubq (2*p_Nq-1)
#define p_Nsubp (p_Nsubq*p_Nsubq)

@kernel void bnsHczProjectSubcellQuad2D(const dlong Nelements,
                                       @restrict const dlong *elementIds,
                                       @restrict const dfloat *A,
                                       @restrict const dfloat *q,
                                       @restrict dfloat *sub){
  for(dlong et=0;et<Nelements;++et;@outer(0)){
    @shared dfloat s_q[12][p_Nq][p_Nq];
    @shared dfloat s_A[p_Nsubq][p_Nq];
    for(int j=0;j<p_Nsubq;++j;@inner(1)){
      for(int i=0;i<p_Nsubq;++i;@inner(0)){
        if(i<p_Nq)s_A[j][i]=A[j+i*p_Nsubq];
        if(i<p_Nq && j<p_Nq){
          for(int k=0;k<12;++k)
            s_q[k][j][i]=q[(elementIds[et]*12+k)*p_Np+j*p_Nq+i];
        }
      }
    }
    for(int j=0;j<p_Nsubq;++j;@inner(1)){
      for(int i=0;i<p_Nsubq;++i;@inner(0)){
        for(int k=0;k<12;++k){
          dfloat value=0.0;
          // Keep the host full tensor contraction and accumulation order.
          for(int a=0;a<p_Nq;++a)for(int b=0;b<p_Nq;++b)
            value += s_A[j][a]*s_A[i][b]*s_q[k][a][b];
          sub[(elementIds[et]*12+k)*p_Nsubp+j*p_Nsubq+i]=value;
        }
      }
    }
  }
}

// Apply the host's conservative index-family scaling IN PLACE. It adjusts
// moments 0..5 together around their individual element averages; moments
// 6..11 are untouched. invalid[e]=1 means the mean cannot be repaired and
// that element is left unchanged. All input subcell values must be finite.
@kernel void bnsHczScaleSubcellQuad2D(const dlong Nelements,
                                     @restrict const dlong *elementIds,
                                     const dfloat phiFloor,
                                     @restrict dfloat *sub,
                                     @restrict int *invalid){
  for(dlong et=0;et<Nelements;++et;@outer(0)){
    @shared dfloat s_sub[6][p_Nsubq][p_Nsubq];
    @shared dfloat s_avg[6];
    @shared dfloat s_theta[1];
    @shared int s_scale[1];
    for(int j=0;j<p_Nsubq;++j;@inner(1)){
      for(int i=0;i<p_Nsubq;++i;@inner(0)){
        for(int k=0;k<6;++k)
          s_sub[k][j][i]=sub[(elementIds[et]*12+k)*p_Nsubp+j*p_Nsubq+i];
      }
    }
    for(int j=0;j<p_Nsubq;++j;@inner(1)){
      for(int i=0;i<p_Nsubq;++i;@inner(0)){
        if(i==0 && j==0){
          dfloat minPhi=s_sub[0][0][0];
          for(int k=0;k<6;++k)s_avg[k]=0.0;
          for(int a=0;a<p_Nsubq;++a)for(int b=0;b<p_Nsubq;++b){
            if(s_sub[0][a][b]<minPhi)minPhi=s_sub[0][a][b];
            for(int k=0;k<6;++k)s_avg[k]+=s_sub[k][a][b]/p_Nsubp;
          }
          s_scale[0]=0;
          int bad=0;
          if(minPhi<=phiFloor){
            if(s_avg[0]<=phiFloor)bad=1;
            else{
              s_theta[0]=(s_avg[0]-phiFloor)/(s_avg[0]-minPhi)*(1.0-1e-12);
              s_scale[0]=1;
            }
          }
          invalid[elementIds[et]]=bad;
        }
      }
    }
    for(int j=0;j<p_Nsubq;++j;@inner(1)){
      for(int i=0;i<p_Nsubq;++i;@inner(0)){
        if(s_scale[0]){
          for(int k=0;k<6;++k)
            sub[(elementIds[et]*12+k)*p_Nsubp+j*p_Nsubq+i]
              =s_avg[k]+s_theta[0]*(s_sub[k][j][i]-s_avg[k]);
        }
      }
    }
  }
}
