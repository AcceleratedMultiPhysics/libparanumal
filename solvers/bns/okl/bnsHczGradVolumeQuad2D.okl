// Central DG gradient, volume part. Potentials: [element][psiPhi, psiRho][node].
// Gradients: [element][psiPhi_x, psiPhi_y, psiRho_x, psiRho_y][node].
// This initializes selected gradient entries; the surface kernel adds to them.
@kernel void bnsHczGradVolumeQuad2D(const dlong Nelements,
                                   @restrict const dlong *elementIds,
                                   @restrict const dfloat *vgeo,
                                   @restrict const dfloat *DT,
                                   @restrict const dfloat *potentials,
                                   @restrict dfloat *gradients){
  for(dlong eo=0;eo<Nelements;eo+=p_NblockV;@outer(0)){
    @shared dfloat s_q[p_NblockV][2][p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    for(int es=0;es<p_NblockV;++es;@inner(2)){
      for(int j=0;j<p_Nq;++j;@inner(1)){
        for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong et = eo+es;
          if(et<Nelements){
            const dlong e = elementIds[et];
            for(int fld=0;fld<2;++fld)
              s_q[es][fld][j][i] = potentials[(e*2+fld)*p_Np+j*p_Nq+i];
          }
          if(es==0)s_DT[j][i] = DT[j*p_Nq+i];
        }
      }
    }

    for(int es=0;es<p_NblockV;++es;@inner(2)){
      for(int j=0;j<p_Nq;++j;@inner(1)){
        for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong et = eo+es;
          if(et<Nelements){
            const dlong e = elementIds[et];
            const dlong gid = e*p_Np*p_Nvgeo+j*p_Nq+i;
            const dfloat rx = vgeo[gid+p_RXID*p_Np];
            const dfloat ry = vgeo[gid+p_RYID*p_Np];
            const dfloat sx = vgeo[gid+p_SXID*p_Np];
            const dfloat sy = vgeo[gid+p_SYID*p_Np];
            for(int fld=0;fld<2;++fld){
              dfloat dr = 0.0, ds = 0.0;
              #pragma unroll p_Nq
              for(int m=0;m<p_Nq;++m){
                dr += s_DT[i][m]*s_q[es][fld][j][m];
                ds += s_DT[j][m]*s_q[es][fld][m][i];
              }
              const dlong base = (e*4+2*fld)*p_Np+j*p_Nq+i;
              gradients[base] = rx*dr+sx*ds;
              gradients[base+p_Np] = ry*dr+sy*ds;
            }
          }
        }
      }
    }
  }
}
