// One synchronous 3x3 expansion layer for a binary HCZ element mask.
// neighbors[e][(dy+1)*3+dx+1] includes self; negative entries are walls.
// The caller exchanges oldMask halos before each layer. oldMask and newMask
// must not alias: newly marked elements must not propagate within this layer.
@kernel void bnsHczExpandMaskQuad2D(const dlong Nelements,
                                    @restrict const dlong *elementIds,
                                    @restrict const dlong *neighbors,
                                    @restrict const int *oldMask,
                                    @restrict int *newMask){
  for(dlong block=0;block<(Nelements+255)/256;++block;@outer(0)){
    for(int t=0;t<256;++t;@inner(0)){
      const dlong et=block*256+t;
      if(et<Nelements){
        const dlong e=elementIds[et];
        int marked=oldMask[e]!=0;
        for(int k=0;k<9;++k){
          const dlong nb=neighbors[9*e+k];
          if(nb>=0 && oldMask[nb]!=0)marked=1;
        }
        newMask[e]=marked;
      }
    }
  }
}
