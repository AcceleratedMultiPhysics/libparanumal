// HCZ nodal preparation. q uses [element][12 moments][node].
// Outputs: rho[element][node], potentials[element][psiPhi, psiRho][node].
// Caller supplies finite admissible nodal states and valid EOS/density parameters.
#if p_Nfields != 12
#error HCZ Quad2D thermodynamics requires twelve fields
#endif

@kernel void bnsHczThermodynamicsQuad2D(const dlong Nelements,
                                       @restrict const dlong *elementIds,
                                       const dfloat c,
                                       const dfloat rhoL,
                                       const dfloat rhoH,
                                       const dfloat phiL,
                                       const dfloat phiH,
                                       const dfloat eosB,
                                       const dfloat eosRatio,
                                       @restrict const dfloat *q,
                                       @restrict dfloat *rho,
                                       @restrict dfloat *potentials){
  for(dlong eo=0;eo<Nelements;eo+=p_NblockV;@outer(0)){
    for(int es=0;es<p_NblockV;++es;@inner(2)){
      for(int j=0;j<p_Nq;++j;@inner(1)){
        for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong et = eo+es;
          if(et<Nelements){
            const dlong e = elementIds[et];
            const int node = j*p_Nq+i;
            const dlong base = e*p_Nfields*p_Np+node;
            const dfloat phi = q[base];
            const dfloat density = rhoL+(phi-phiL)*(rhoH-rhoL)/(phiH-phiL);
            const dfloat c2 = c*c;
            const dfloat eta = eosB*phi/4.0;
            const dfloat denominator = 1.0-eta;
            const dfloat pressureCS = c2*phi*(1.0+eta+eta*eta-eta*eta*eta)
                                     /(denominator*denominator*denominator)
                                     -eosRatio*eosB*c2*phi*phi;
            rho[e*p_Np+node] = density;
            potentials[e*2*p_Np+node] = pressureCS-c2*phi;
            potentials[e*2*p_Np+p_Np+node] = q[base+6*p_Np]-c2*density;
          }
        }
      }
    }
  }
}
