// Central scalar traces, following the libp Quad2D gradient surface assembly.
// EToB <= 0: interior/periodic; EToB == 1: stationary wall, scalarP=scalarM.
// Caller validates boundary tags and supplies potential halos before launch.
void hczGradientSurfaceTerms(const dlong e,
                              const int es,
                              const dlong sk,
                              const int face,
                              const int i,
                              const int j,
                              const dfloat *sgeo,
                              const dlong *vmapM,
                              const dlong *vmapP,
                              const int *EToB,
                              const dfloat *potentials,
                              dfloat s_flux[p_NblockS][4][p_Nq][p_Nq]){
  // A copied scalar wall trace has exactly zero jump. Do not read its
  // exterior map: no exterior potential value is required at a wall.
  if(EToB[e*p_Nfaces+face]!=1){
    const dlong idM = vmapM[sk];
    const dlong idP = vmapP[sk];
    const dlong baseM = e*2*p_Np+idM%p_Np;
    const dlong baseP = (idP/p_Np)*2*p_Np+idP%p_Np;
    const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID];
    const dfloat ny = sgeo[sk*p_Nsgeo+p_NYID];
    const dfloat sc = 0.5*sgeo[sk*p_Nsgeo+p_WIJID]*sgeo[sk*p_Nsgeo+p_SJID];
    for(int fld=0;fld<2;++fld){
      const dfloat jump = potentials[baseP+fld*p_Np]-potentials[baseM+fld*p_Np];
      s_flux[es][2*fld][j][i] += sc*nx*jump;
      s_flux[es][2*fld+1][j][i] += sc*ny*jump;
    }
  }
}

@kernel void bnsHczGradSurfaceQuad2D(const dlong Nelements,
                                    @restrict const dlong *elementIds,
                                    @restrict const dfloat *sgeo,
                                    @restrict const dlong *vmapM,
                                    @restrict const dlong *vmapP,
                                    @restrict const int *EToB,
                                    @restrict const dfloat *potentials,
                                    @restrict dfloat *gradients){
  for(dlong eo=0;eo<Nelements;eo+=p_NblockS;@outer(0)){
    @shared dfloat s_flux[p_NblockS][4][p_Nq][p_Nq];

    for(int es=0;es<p_NblockS;++es;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
        for(int j=0;j<p_Nq;++j)
          for(int fld=0;fld<4;++fld)s_flux[es][fld][j][i] = 0.0;
      }
    }

    // Opposing face pairs are assembled in separate stages so corners
    // accumulate both corrections without concurrent shared-memory writes.
    for(int es=0;es<p_NblockS;++es;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong et = eo+es;
        if(et<Nelements){
          const dlong e = elementIds[et];
          const dlong sk0 = (e*p_Nfaces+0)*p_Nfp+i;
          const dlong sk2 = (e*p_Nfaces+2)*p_Nfp+i;
          hczGradientSurfaceTerms(e,es,sk0,0,i,0,sgeo,vmapM,vmapP,EToB,potentials,s_flux);
          hczGradientSurfaceTerms(e,es,sk2,2,i,p_Nq-1,sgeo,vmapM,vmapP,EToB,potentials,s_flux);
        }
      }
    }

    for(int es=0;es<p_NblockS;++es;@inner(1)){
      for(int j=0;j<p_Nq;++j;@inner(0)){
        const dlong et = eo+es;
        if(et<Nelements){
          const dlong e = elementIds[et];
          const dlong sk1 = (e*p_Nfaces+1)*p_Nfp+j;
          const dlong sk3 = (e*p_Nfaces+3)*p_Nfp+j;
          hczGradientSurfaceTerms(e,es,sk1,1,p_Nq-1,j,sgeo,vmapM,vmapP,EToB,potentials,s_flux);
          hczGradientSurfaceTerms(e,es,sk3,3,0,j,sgeo,vmapM,vmapP,EToB,potentials,s_flux);
        }
      }
    }

    for(int es=0;es<p_NblockS;++es;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong et = eo+es;
        if(et<Nelements){
          const dlong e = elementIds[et];
          for(int j=0;j<p_Nq;++j)
            for(int fld=0;fld<4;++fld)
              gradients[(e*4+fld)*p_Np+j*p_Nq+i] += s_flux[es][fld][j][i];
        }
      }
    }
  }
}
